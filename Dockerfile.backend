# Vana Resort Araku — PHP Backend Docker Image
# PHP 8.2 + Apache + PDO MySQL extensions
FROM php:8.2-apache

# Enable required PHP extensions
RUN docker-php-ext-install pdo pdo_mysql

# Enable Apache mod_rewrite for clean URLs
RUN a2enmod rewrite

# Set Apache document root to backend/
ENV APACHE_DOCUMENT_ROOT /var/www/html/backend

# Update Apache config to use new document root
RUN sed -ri -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' \
    /etc/apache2/sites-available/*.conf && \
    sed -ri -e 's!/var/www/!${APACHE_DOCUMENT_ROOT}!g' \
    /etc/apache2/apache2.conf /etc/apache2/conf-available/*.conf

# Allow .htaccess overrides
RUN echo '<Directory /var/www/html/backend>\n\
    AllowOverride All\n\
    Require all granted\n\
</Directory>' > /etc/apache2/conf-available/vana-resort.conf && \
    a2enconf vana-resort

# Copy entire project into container
COPY . /var/www/html/

# Set correct permissions
RUN chown -R www-data:www-data /var/www/html/backend && \
    chmod -R 755 /var/www/html/backend && \
    chmod -R 777 /var/www/html/backend/uploads && \
    chmod -R 777 /var/www/html/backend/logs

# Create upload & log directories if they don't exist
RUN mkdir -p /var/www/html/backend/uploads && \
    mkdir -p /var/www/html/backend/logs

EXPOSE 80
