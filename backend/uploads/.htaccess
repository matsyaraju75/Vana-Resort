# Disable script execution inside uploads directory
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|phps|pl|py|cgi|sh|bash)$">
    Require all denied
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Only allow legitimate static files
<FilesMatch "(?i)\.(jpg|jpeg|png|gif|webp|svg|ico)$">
    Require all granted
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>
